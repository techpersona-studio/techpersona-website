---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/work.css";
import { listCases, rgb, thumbOf, TYPE_LABEL } from "../../data/cases";
import { SITE_NAME, absUrl } from "../../lib/blog";

const cases = listCases();
const pageTitle = "Work: Websites and AI Story Ads | TechPersona Studio";
const description =
  "Websites that bring small businesses customers, and AI story ads that get shared. See the real sites, before and after, and the results.";
const workUrl = absUrl("/work");

// hook split at sentence/comma breaks for the masked hover reveal
const lines = (t: string) => (t ? t.replace(/([.,])\s+/g, "$1\n").split("\n").slice(0, 3) : []);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": workUrl + "#page",
    url: workUrl,
    name: "Websites and ads by TechPersona Studio",
    description,
    inLanguage: "en-US",
    isPartOf: { "@type": "WebSite", name: SITE_NAME, url: absUrl("/") },
    mainEntity: {
      "@type": "ItemList",
      itemListElement: cases.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        url: absUrl(`/work/${c.slug}`),
        name: c.name,
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absUrl("/") },
      { "@type": "ListItem", position: 2, name: "Work", item: workUrl },
    ],
  },
];
---

<BaseLayout title={pageTitle} description={description} ogTitle="Websites that bring you customers. Ads that get your product shared." jsonLd={jsonLd}>
  <script slot="head" is:inline>document.documentElement.classList.add("js");</script>
  <div class="wk">
    <section class="wrap hero">
      <span class="trk">Work</span>
      <h1>Websites that bring you customers. <span class="serif-i">Ads that get your product shared.</span></h1>
      <p>Open a project to scroll the real site.</p>
      <span class="side" aria-hidden="true">Scroll</span>
    </section>

    <section class="wrap" style="max-width:1360px" aria-label="Projects">
      <div class="deck" id="deck">
        {cases.map((c, i) => {
          const ad = c.type === "ad-video";
          const pos = !ad && c.media.cover?.pos ? `object-position:${c.media.cover.pos}` : undefined;
          const res = c.proof[0] ? `${c.proof[0].value} ${c.proof[0].label}` : c.hook;
          const type = ad ? TYPE_LABEL[c.type] : c.kind;
          return (
            <a class:list={["card", "rv", { v: ad }]} href={`/work/${c.slug}`} style={`--acc-rgb:${rgb(c.accent)}`}>
              <div class="plane">
                <div class="frame">
                  <div class="img">
                    <div class="panel" aria-hidden="true">
                      {lines(c.hook).map((l) => <span class="ln"><span>{l}</span></span>)}
                    </div>
                    <div class="ph">
                      <img src={thumbOf(c)} alt="" style={pos} loading={i < 2 ? "eager" : "lazy"} decoding="async" />
                    </div>
                    {c.stamp && <span class="stamp" aria-hidden="true">{c.stamp}</span>}
                    <span class="go" aria-hidden="true">&#8599;</span>
                  </div>
                  <div class="meta">
                    <h2>{c.name}</h2>
                    <p>{type}</p>
                    {res && <p class="res">{res}</p>}
                  </div>
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

    <section class="xcta">
      <div class="wrap">
        <h2>Want to see what yours <span class="serif-i">could look like?</span></h2>
        <a href="/#audit" class="island-btn island-btn--terra">Send me your URL <span class="island-btn__icon" aria-hidden="true">&#8594;</span></a>
        <p class="trust">Free &middot; no commitment &middot; audit in 2 days</p>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const fine = matchMedia("(hover: hover) and (pointer: fine)").matches && !reduced;
  const deck = document.getElementById("deck");
  if (deck) {
    const cards = deck.querySelectorAll<HTMLElement>(".card");

    // dim siblings while one card is hovered
    deck.addEventListener("pointerover", (e) => {
      if ((e.target as Element).closest(".card")) deck.classList.add("hovering");
    });
    deck.addEventListener("pointerout", (e) => {
      const to = e.relatedTarget as Element | null;
      if (!to || !deck.contains(to) || !to.closest(".card")) deck.classList.remove("hovering");
    });

    // reveal on scroll
    if ("IntersectionObserver" in window && !reduced) {
      const io = new IntersectionObserver(
        (es) => es.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } }),
        { rootMargin: "0px 0px -10% 0px" },
      );
      cards.forEach((c) => io.observe(c));
    } else cards.forEach((c) => c.classList.add("in"));

    // tilt toward the pointer + magnetic arrow (mouse only)
    if (fine) cards.forEach((card) => {
      const im = card.querySelector<HTMLElement>(".img");
      card.addEventListener("pointermove", (e) => {
        const r = card.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5, y = (e.clientY - r.top) / r.height - 0.5;
        card.classList.add("tilting");
        card.style.setProperty("--ry", (x * 9).toFixed(2) + "deg");
        card.style.setProperty("--rx", (-y * 7).toFixed(2) + "deg");
        card.style.setProperty("--mx", (x * 2).toFixed(3));
        card.style.setProperty("--my", (y * 2).toFixed(3));
        if (im) {
          const ir = im.getBoundingClientRect();
          const gx = Math.max(40, Math.min(ir.width - 40, e.clientX - ir.left));
          const gy = Math.max(40, Math.min(ir.height - 40, e.clientY - ir.top));
          im.style.setProperty("--gx", gx.toFixed(0) + "px");
          im.style.setProperty("--gy", gy.toFixed(0) + "px");
        }
      });
      card.addEventListener("pointerleave", () => {
        card.classList.remove("tilting");
        ["--rx", "--ry"].forEach((k) => card.style.setProperty(k, "0deg"));
        ["--mx", "--my"].forEach((k) => card.style.setProperty(k, "0"));
      });
    });
  }
</script>
