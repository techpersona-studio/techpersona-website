---
import type { WordPressPost } from "../../lib/wordpress";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/BlogCard.astro";
import BlogDiscussion from "../../components/BlogDiscussion.astro";
import EndCta from "../../components/EndCta.astro";
import {
  getCommentsForPost,
  getPostsForNavigation,
  getWordPressCommentActionUrl,
  getWordPressCommentsApiUrl,
  getFeaturedImageAlt,
  getFeaturedImageUrl,
  getPosts,
} from "../../lib/wordpress";
import {
  AUTHOR,
  SITE_NAME,
  absUrl,
  manualExcerpt,
  formatShortDate,
  laneOf,
  metaDescription,
  postTitle,
  prepareArticle,
  primaryTopic,
  readingMinutes,
  seoTitle,
} from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: WordPressPost;
}

const { post } = Astro.props;
const title = postTitle(post);
const description = metaDescription(post);
const dek = manualExcerpt(post);
const imageUrl = getFeaturedImageUrl(post);
const imageAlt = getFeaturedImageAlt(post) || title;
const topic = primaryTopic(post);
const lane = laneOf(post);
const mins = readingMinutes(post);
const { html, toc } = prepareArticle(post.content.rendered);
const showToc = toc.length >= 3;
const modified = (post as WordPressPost & { modified?: string }).modified ?? post.date;
const postUrl = absUrl(`/blog/${post.slug}`);

const comments = await getCommentsForPost(post.id);
const navigationPosts = await getPostsForNavigation();
const i = navigationPosts.findIndex((p) => p.id === post.id);
const previousPost = i > 0 ? navigationPosts[i - 1] : null;
const nextPost = i >= 0 && i < navigationPosts.length - 1 ? navigationPosts[i + 1] : null;

// related: same lane first, then the rest; never prev/next or self
const all = await getPosts();
const skip = new Set([post.id, previousPost?.id, nextPost?.id]);
const pool = all.filter((p) => !skip.has(p.id));
const related = [...pool.filter((p) => laneOf(p).id === lane.id), ...pool.filter((p) => laneOf(p).id !== lane.id)].slice(0, 3);

const navTitle = (p: { title: { rendered: string } }) => postTitle(p as WordPressPost);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "@id": postUrl + "#article",
    headline: title.length > 110 ? title.slice(0, 109) + "…" : title,
    description,
    url: postUrl,
    mainEntityOfPage: { "@type": "WebPage", "@id": postUrl },
    datePublished: new Date(post.date).toISOString(),
    dateModified: new Date(modified).toISOString(),
    image: imageUrl ?? absUrl("/assets/images/og-image.jpg"),
    articleSection: topic,
    inLanguage: "en-US",
    author: {
      "@type": "Person",
      name: AUTHOR.name,
      jobTitle: "Founder",
      url: absUrl("/#about"),
      image: absUrl(AUTHOR.avatar),
      worksFor: { "@type": "Organization", name: SITE_NAME },
    },
    publisher: {
      "@type": "Organization",
      name: SITE_NAME,
      url: absUrl("/"),
      logo: { "@type": "ImageObject", url: absUrl("/assets/images/logo.png") },
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: absUrl("/") },
      { "@type": "ListItem", position: 2, name: "Blog", item: absUrl("/blog") },
      { "@type": "ListItem", position: 3, name: title, item: postUrl },
    ],
  },
];
---

<BaseLayout
  title={seoTitle(title)}
  ogTitle={title}
  description={description}
  image={imageUrl}
  imageAlt={imageUrl ? imageAlt : undefined}
  type="article"
  publishedTime={new Date(post.date).toISOString()}
  modifiedTime={new Date(modified).toISOString()}
  jsonLd={jsonLd}
>
  <div class="progress" aria-hidden="true"><i data-progress></i></div>

  <article class="post" data-article>
    <header class="post-head page-shell">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href="/blog">Blog</a>
        <span aria-hidden="true">/</span>
        <span>{topic}</span>
      </nav>
      <h1 class="post-head__title">{title}</h1>
      {dek && <p class="post-head__dek">{dek}</p>}
      <div class="byline">
        <img src={AUTHOR.avatar} alt="" width="44" height="44" class="byline__img" />
        <p class="byline__who">
          <b>{AUTHOR.name}</b>
          <span>Founder</span>
        </p>
        <p class="byline__meta">
          <time datetime={post.date}>{formatShortDate(post.date)}</time>
          <span aria-hidden="true">·</span>
          <span>{mins} min read</span>
        </p>
      </div>
    </header>

    {imageUrl && (
      <figure class="post-hero page-shell">
        <img src={imageUrl} alt={imageAlt} fetchpriority="high" decoding="async" />
      </figure>
    )}

    <div class:list={["post-grid page-shell", { "post-grid--toc": showToc }]}>
      {showToc && (
        <aside class="toc toc--rail" aria-label="On this page">
          <p class="toc__h">On this page</p>
          <ol>
            {toc.map((t) => (
              <li class:list={[`toc__l${t.level}`]}><a href={`#${t.id}`} data-toc-link>{t.text}</a></li>
            ))}
          </ol>
        </aside>
      )}

      <div class="post-main">
        {showToc && (
          <details class="toc toc--fold">
            <summary>
              <span>On this page</span>
              <small>{toc.length} sections</small>
            </summary>
            <ol>
              {toc.map((t) => (
                <li class:list={[`toc__l${t.level}`]}><a href={`#${t.id}`}>{t.text}</a></li>
              ))}
            </ol>
          </details>
        )}

        <div class="article-content" set:html={html} />

        <aside class="authorbox" aria-label="About the author">
          <img src={AUTHOR.avatar} alt={AUTHOR.name} width="72" height="72" loading="lazy" />
          <div>
            <p class="authorbox__k">Written by</p>
            <p class="authorbox__name">{AUTHOR.name} <span>{AUTHOR.role}</span></p>
            <p class="authorbox__bio">{AUTHOR.bio}</p>
            <a href="/#about" class="authorbox__more">More about Thao <span aria-hidden="true">&#8594;</span></a>
          </div>
        </aside>
      </div>
    </div>
  </article>

  <div class="page-shell post-after">
    <EndCta variant="card" />

    {(previousPost || nextPost) && (
      <nav class="pn" aria-label="More posts">
        {previousPost ? (
          <a href={`/blog/${previousPost.slug}`} class="pn__a pn__a--prev" rel="prev">
            <span class="pn__k"><span aria-hidden="true">&#8592;</span> Previous</span>
            <span class="pn__t">{navTitle(previousPost)}</span>
          </a>
        ) : <span />}
        {nextPost && (
          <a href={`/blog/${nextPost.slug}`} class="pn__a pn__a--next" rel="next">
            <span class="pn__k">Next <span aria-hidden="true">&#8594;</span></span>
            <span class="pn__t">{navTitle(nextPost)}</span>
          </a>
        )}
      </nav>
    )}

    {related.length > 0 && (
      <section class="related" aria-labelledby="related-h">
        <div class="related__head">
          <h2 id="related-h">Keep reading</h2>
          <a href="/blog">All posts <span aria-hidden="true">&#8594;</span></a>
        </div>
        <div class="related__grid">
          {related.map((p) => <BlogCard post={p} variant="related" />)}
        </div>
      </section>
    )}

    <div class="post-comments">
      <BlogDiscussion
        title={title}
        pageUrl={postUrl}
        comments={comments}
        commentsApiUrl={getWordPressCommentsApiUrl(post.id)}
        commentActionUrl={getWordPressCommentActionUrl()}
        postId={post.id}
      />
    </div>
  </div>
</BaseLayout>

<script>
  // reading progress: scroll handler writes one transform, no rAF dependency
  const bar = document.querySelector<HTMLElement>("[data-progress]");
  const body = document.querySelector<HTMLElement>("[data-article] .article-content");
  if (bar && body) {
    const update = () => {
      const r = body.getBoundingClientRect();
      const total = r.height - window.innerHeight * 0.6;
      const p = total > 0 ? Math.min(1, Math.max(0, -r.top / total)) : 1;
      bar.style.transform = `scaleX(${p})`;
    };
    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update, { passive: true });
  }

  // TOC: mark the section in view
  const links = [...document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")];
  if (links.length && "IntersectionObserver" in window) {
    const byId = new Map(links.map((a) => [decodeURIComponent(a.hash.slice(1)), a]));
    const heads = [...byId.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    const setActive = (id: string) => links.forEach((a) => a.toggleAttribute("aria-current", byId.get(id) === a));
    const io = new IntersectionObserver(
      (entries) => {
        const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (vis[0]) setActive(vis[0].target.id);
      },
      { rootMargin: "-80px 0px -65% 0px" },
    );
    heads.forEach((h) => io.observe(h));
  }

  // close the mobile TOC after a jump
  document.querySelectorAll<HTMLAnchorElement>(".toc--fold a").forEach((a) =>
    a.addEventListener("click", () => a.closest("details")?.removeAttribute("open")),
  );
</script>
