---
import "../styles/global.css";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  canonical?: string;
  type?: "website" | "article";
  ogTitle?: string;
  publishedTime?: string;
  modifiedTime?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  // Page language. "vi" pages live under /vi and ship Vietnamese chrome.
  lang?: "en" | "vi";
  // EN/VI twin paths (e.g. { en: "/work", vi: "/vi/work" }). Emits hreflang
  // alternates + og:locale and shows the language switch in the header.
  // Leave out for EN-only pages (blog, service pages).
  alternates?: { en: string; vi: string };
}

const { title, description, image, imageAlt, canonical, type = "website", ogTitle, publishedTime, modifiedTime, jsonLd, lang = "en", alternates } = Astro.props;
const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? Astro.site?.href ?? "";
const pageDescription = description ?? "Plain-language notes on web design, SEO and AI ads for small businesses, from TechPersona Studio in Worcester, MA.";
// new URL() joins cleanly whether siteUrl ends in "/" or not (was producing com//assets)
const ogImage = image ?? (siteUrl ? new URL("/assets/images/og-image.jpg", siteUrl).href : undefined);
// Strip the trailing slash (except root) so the canonical matches the URL the
// site actually serves — vercel.json trailingSlash:false 308s /path/ → /path.
const canonicalPath = Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "");
const abs = (path: string) => (siteUrl ? new URL(path, siteUrl).href : path);
const canonicalUrl = canonical ?? (siteUrl ? new URL(canonicalPath, siteUrl).href : undefined);
const pageUrl = canonicalUrl ?? Astro.url.href;
const ldBlocks = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={pageDescription} />
    <meta name="theme-color" content="#f6f3ee" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/HankenGrotesk-normal-latin.woff2" crossorigin="anonymous" />
    <link rel="preload" as="font" type="font/woff2" href="/assets/fonts/CormorantGaramond-italic-latin.woff2" crossorigin="anonymous" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {alternates && <link rel="alternate" hreflang="en" href={abs(alternates.en)} />}
    {alternates && <link rel="alternate" hreflang="vi" href={abs(alternates.vi)} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={abs(alternates.en)} />}
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="TechPersona Studio" />
    <meta property="og:locale" content={lang === "vi" ? "vi_VN" : "en_US"} />
    {alternates && <meta property="og:locale:alternate" content={lang === "vi" ? "en_US" : "vi_VN"} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={pageDescription} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {ldBlocks.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{lang === "vi" ? "Chuyển đến nội dung chính" : "Skip to content"}</a>
    <SiteHeader lang={lang} alternates={alternates} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
