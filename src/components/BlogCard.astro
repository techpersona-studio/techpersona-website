---
import type { WordPressPost } from "../lib/wordpress";
import PostCover from "./PostCover.astro";
import { excerptFor, formatShortDate, laneOf, postTitle, primaryTopic, readingMinutes } from "../lib/blog";

interface Props {
  post: WordPressPost;
  variant?: "feature" | "grid" | "related";
  index?: number;
  headingLevel?: 2 | 3;
}

const { post, variant = "grid", index, headingLevel = 3 } = Astro.props;
const title = postTitle(post);
const excerpt = excerptFor(post);
const lane = laneOf(post);
const topic = primaryTopic(post);
const mins = readingMinutes(post);
const date = formatShortDate(post.date);
const H = `h${headingLevel}` as "h2" | "h3";
---

<article class:list={["bcard", `bcard--${variant}`]} data-lane={lane.id}>
  <a href={"/blog/" + post.slug} class="bcard__link">
    <PostCover post={post} eager={variant === "feature"} class="bcard__media" />
    <div class="bcard__body">
      <p class="bcard__kicker">
        {variant === "feature" && <span class="bcard__new">Latest</span>}
        {typeof index === "number" && <span class="bcard__num">{String(index).padStart(2, "0")}</span>}
        <span>{topic}</span>
      </p>
      <H class="bcard__title"><span>{title}</span></H>
      {variant !== "related" && <p class="bcard__excerpt">{excerpt}</p>}
      <p class="bcard__meta">
        <time datetime={post.date}>{date}</time>
        <span aria-hidden="true">·</span>
        <span>{mins} min read</span>
        {variant === "feature" && (
          <span class="bcard__go" aria-hidden="true">Read the post <span class="bcard__arrow">&#8594;</span></span>
        )}
      </p>
    </div>
  </a>
</article>
