---
// Homepage for both languages: / (en) and /vi (vi). One template, copy from
// src/i18n/home.ts, markup/classes/CSS/JS identical to the old public/index.html.
import { home, type HomeLang } from "../i18n/home";
import { homeMeta } from "../i18n/home-meta";
import ldEn from "../i18n/home-ld.json";

interface Props { lang: HomeLang }
const { lang } = Astro.props;
const t = home[lang];
const meta = homeMeta[lang];

const SITE = (import.meta.env.PUBLIC_SITE_URL ?? Astro.site?.href ?? "https://www.techpersonastudio.com").replace(/\/$/, "");
const links = { en: "/", vi: "/vi" };
const canonical = SITE + (lang === "vi" ? "/vi" : "/");
const p = (path: string) => (lang === "vi" ? "/vi" + path : path);
const OG_IMAGE = SITE + "/assets/images/og-image.jpg";

const ENT: Record<string, string> = { "&amp;": "&", "&lt;": "<", "&gt;": ">", "&quot;": '"', "&#39;": "'", "&middot;": "·", "&rsquo;": "’", "&nbsp;": " " };
const dec = (s: string) => s.replace(/&#(\d+);|&#x([\da-f]+);|&[a-z]+;/gi, (m, d, h) => (d ? String.fromCharCode(+d) : h ? String.fromCharCode(parseInt(h, 16)) : ENT[m] ?? m));
const plain = (s: string) => dec(s.replace(/<[^>]+>/g, ""));

// JSON-LD: EN is the original block. VI reuses the same graph (entities keep
// their @id) with the FAQ taken from the Vietnamese strings.
const ld: any = JSON.parse(JSON.stringify(ldEn));
for (const node of ld["@graph"]) {
  if (lang === "vi" && node["@type"] === "FAQPage") {
    node.name = "Câu hỏi thường gặp, TechPersona Studio";
    node.url = canonical + "#faq";
    node.inLanguage = "vi";
    node.mainEntity = node.mainEntity.map((_: unknown, i: number) => ({
      "@type": "Question",
      name: plain((t as any)[`faq_q${i + 1}`]),
      acceptedAnswer: { "@type": "Answer", text: plain((t as any)[`faq_a${i + 1}`]) },
    }));
  }
  if (lang === "vi" && node["@type"] === "WebSite") node.inLanguage = ["en-US", "vi-VN"];
}
const ldJson = JSON.stringify(ld).replace(/</g, "\\u003c");

// Strings the page script needs at runtime (form button states, phone label).
const runtime = JSON.stringify({
  form_opt: t.form_opt,
  form_opt_required: t.form_opt_required,
  form_sending: t.form_sending,
  form_submit: t.form_submit,
}).replace(/</g, "\\u003c");
