<!-- Google Tag Manager (deferred: loads on first interaction, idle fallback) -->
<script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];var done=false;
function load(){if(done)return;done=true;w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});
var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;
j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);}
['scroll','pointerdown','keydown','touchstart'].forEach(function(e){
w.addEventListener(e,load,{passive:true,once:true});});
// fallback so visitors who never interact still get counted
if('requestIdleCallback' in w){w.requestIdleCallback(load,{timeout:10000});}else{setTimeout(load,10000);}
})(window,document,'script','dataLayer','GTM-NDQ8ZJ9B');</script>
<!-- End Google Tag Manager -->
