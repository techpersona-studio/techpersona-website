        <li><span class="ck">&#10003;</span> <span data-i18n="offer_li5" set:html={t.offer_li5}></span></li>
      </ul>
      <p class="after-line" data-i18n-html="offer_after" set:html={t.offer_after}></p>
      <p class="contact-inline" data-i18n-html="offer_contact" set:html={t.offer_contact}></p>
    </div>

    <div class="form-shell" data-reveal data-d="1">
      <div class="form-card" id="formCard">
        <div class="form-body">
          <h3 data-i18n="form_h3" set:html={t.form_h3}></h3>
          <p class="f-sub" data-i18n="form_sub" set:html={t.form_sub}></p>
          <p class="f-no-site" data-i18n-html="form_no_site" set:html={t.form_no_site}></p>
          <form id="auditForm" novalidate>
            <div class="field" id="f-name">
              <label for="name" data-i18n="form_label_name" set:html={t.form_label_name}></label>
              <input id="name" name="name" type="text" placeholder="Jordan Avery" required>
              <span class="err-msg" data-i18n="form_err_name" set:html={t.form_err_name}></span>
            </div>
            <div class="field" id="f-email">
              <label for="email" data-i18n="form_label_email" set:html={t.form_label_email}></label>
              <input id="email" name="email" type="email" placeholder="jordan@yourbusiness.com" required>
              <span class="err-msg" data-i18n="form_err_email" set:html={t.form_err_email}></span>
            </div>
            <div class="field" id="f-site">
              <label for="site" data-i18n="form_label_site" set:html={t.form_label_site}></label>
              <input id="site" name="site" type="url" placeholder="https://yourbusiness.com" required>
              <span class="err-msg" data-i18n="form_err_site" set:html={t.form_err_site}></span>
            </div>
            <div class="field" id="f-phone">
              <label for="phone"><span data-i18n="form_label_phone" set:html={t.form_label_phone}></span> <span class="opt" id="phoneOpt" data-i18n="form_opt" set:html={t.form_opt}></span></label>
              <input id="phone" name="phone" type="tel" placeholder="+1 (555) 000-0000">
              <span class="err-msg" data-i18n="form_err_phone" set:html={t.form_err_phone}></span>
            </div>
            <div class="field">
              <label for="problems"><span data-i18n="form_label_problems" set:html={t.form_label_problems}></span> <span class="opt" data-i18n="form_opt" set:html={t.form_opt}></span></label>
              <textarea id="problems" name="problems" data-i18n-placeholder="form_placeholder_problems" placeholder={dec(t.form_placeholder_problems)}></textarea>
            </div>
            <div class="consent">
              <input type="hidden" id="smsOptInValue" name="smsOptIn" value="no">
              <input type="checkbox" id="smsOptIn" value="yes">
              <label for="smsOptIn" data-i18n-html="form_consent" set:html={t.form_consent}></label>
            </div>
            <button type="submit" class="island" data-i18n-html="form_submit" set:html={t.form_submit}></button>
            <div class="form-error" id="formError" data-i18n-html="form_error" set:html={t.form_error}></div>
            <p class="form-fine" data-i18n="form_fine" set:html={t.form_fine}></p>
          </form>
        </div>
        <div class="form-success" id="formSuccess">
          <div class="success-ico" aria-hidden="true"><svg viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg></div>
          <p class="big" data-i18n="form_success_big" set:html={t.form_success_big}></p>
          <p class="msg" data-i18n="form_success_msg" set:html={t.form_success_msg}></p>
        </div>
      </div>
    </div>
  </div>
</section>
